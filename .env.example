# ==============================================================================
# AI Loan Eligibility Checker - Environment Configuration Template
# Copy this file to .env and configure the variables below.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated if multiple, e.g. http://localhost:3000,http://127.0.0.1:5500)
ALLOWED_ORIGINS=http://localhost:3000

# Anthropic Claude API Configuration (Phase 4 integration)
# Get your key from https://console.anthropic.com/
# Leave empty to automatically use the offline Demo Rule-Based Guidance engine.
ANTHROPIC_API_KEY=

# Google Sheets Integration (Phase 5 integration)
# URL of your deployed Google Apps Script Web App
# Leave empty if Google Sheets persistence is not enabled.
GOOGLE_SHEETS_WEBHOOK_URL=
